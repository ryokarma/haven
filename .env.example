# Configuration de la base de données
# Assurez-vous que le chemin correspond à l'organisation de vos volumes (par défaut partagé sur /app/data ou /data selon docker)
DATABASE_URL=sqlite+aiosqlite:///./data/haven.db

# Clé secrète JWT
# À remplacer par une clé sécurisée générée avec par exemple : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=votre_cle_secrete_generee_ici

# Configuration API / Frontend (Réseau et Sécurité)
# URL de base pour les requêtes de l'API Nuxt :
NUXT_PUBLIC_API_BASE=https://api.haven.mondomaine.com
# Domaines autorisés pour le CORS (séparés par des virgules) :
ALLOWED_ORIGINS=https://haven.mondomaine.com,http://localhost:3000
